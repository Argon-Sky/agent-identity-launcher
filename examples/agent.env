# Config for one agent. Copy to ~/.config/argon-agents/<agent>.env; the file name decides the launcher name: argon-<agent> by default.
# None of these values is secret.

# GitHub → the app's settings page → "App ID".
ARGON_APP_ID=1234567

# Where the app's private key is. Either a 1Password secret reference (right-click the field → Copy Secret Reference) ...
ARGON_KEY_REF="op://Private/My Claude GitHub App/private key"
# ... or a path to the .pem file (chmod 600 it):
# ARGON_KEY_REF="~/.local/share/argon-agents/keys/claude.pem"

# The account (organization or user) the app is installed on. Optional when the app has only one installation.
# ARGON_OWNER="my-org"

# The agent command, plus any default arguments. For example:
#   ARGON_COMMAND=(claude --settings '{"attribution":{"commit":"","pr":"","sessionUrl":false}}')   # without Claude Code's Co-Authored-By trailer
#   ARGON_COMMAND=(codex)
#   ARGON_COMMAND=(opencode)
ARGON_COMMAND=(claude)
