# GitHub App identity for `argon-antigravity`. Neither value is secret.
# App ID: Argon Sky org → Settings → Developer settings → GitHub Apps → <app> → "App ID".
ARGON_APP_ID=5063401
# 1Password: right-click the private key field → Copy Secret Reference.
ARGON_KEY_REF="op://Argon Sky/Argon Antigravity GitHub/private key"

# The agent command, plus any default arguments.
ARGON_COMMAND=(agy)
