# GitHub App identity for `argon-claude`. Neither value is secret.
# App ID: Argon Sky org → Settings → Developer settings → GitHub Apps → <app> → "App ID".
ARGON_APP_ID=5063326
# 1Password: right-click the private key field → Copy Secret Reference.
ARGON_KEY_REF="op://Argon Sky/Argon Claude GitHub/private key"

# The agent command, plus any default arguments.
# The bot identity already attributes the work, so hide Claude Code's Co-Authored-By trailer and PR footer.
ARGON_COMMAND=(claude --settings '{"attribution":{"commit":"","pr":"","sessionUrl":false}}')
